[Unit]
Description=HANASO OPS Terminal — internal auth-gateway nginx (loopback only, behind HAProxy)
Documentation=https://github.com/AbolfazlProg/hanaso-ops-terminal
After=network-online.target ops-terminal-gateway.service
Wants=network-online.target

# CP11: bound restart policy. A real failure restarts (on-failure), but a
# persistently broken unit is STOPPED after 5 attempts inside 120s instead of
# looping forever (production incident: restart counter reached 972 with
# Restart=always and no start limit). After the limit, systemd marks the unit
# failed and leaves it down until an operator (or the installer) intervenes.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
# Independent nginx instance (NOT the shared nginx of HANASO/KOTODAMA).
# Runs unprivileged as ops-gw and listens on 127.0.0.1:7680 only; the only
# traffic source is the HAProxy backend for the ops.hanaso.ir SNI/host ACL.
User=ops-gw
Group=ops-gw
# CP11: the PID file is defined EXACTLY ONCE — in nginx.conf (pid directive).
# The old unit redefined it here with -g 'pid ...;' which made nginx abort at
# config parse: "pid directive is duplicate in nginx.conf:5".
#
# CP12: the command line carries NO nginx option that is version-dependent.
# CP11 tried `-e stderr` to redirect the EARLY error log (opened by nginx
# BEFORE the config is parsed) to stderr/journald — but the -e switch exists
# only since nginx 1.19.5 (2020-11-24). The production VPS binary predates it
# (real incident: `nginx: invalid option: "e"`, the unit never started).
# The command line below therefore works on EVERY nginx build.
#
# Early error-log semantics (by design, not a failure):
#   * BEFORE the config parse nginx opens the compiled-in default path
#     (/var/log/nginx/error.log on distro builds). As the unprivileged
#     ops-gw user that open fails — on the VPS with "[alert] could not open
#     error log file ... Permission denied" — nginx logs that single alert
#     to stderr (-> journald) and CONTINUES. It is benign by design: the
#     shared /var/log/nginx directory must stay untouchable for ops-gw.
#   * AFTER the config parse ALL logging goes to the error_log directive in
#     nginx.conf — exclusively under /var/log/ops-terminal (ops-gw-owned).
# The shared nginx and /var/log/nginx permissions are never modified.
#
# CP11: daemon off is set in nginx.conf, so the master stays in the
# foreground and systemd's Type=simple tracks the real main process.
ExecStartPre=/usr/sbin/nginx -c /etc/ops-terminal/nginx/nginx.conf -t
ExecStart=/usr/sbin/nginx -c /etc/ops-terminal/nginx/nginx.conf
ExecReload=/usr/sbin/nginx -c /etc/ops-terminal/nginx/nginx.conf -s reload

# CP11: restart ONLY on real failures (never on a clean stop), and give
# systemd's start-limit above room to trip.
Restart=on-failure
RestartSec=3

# --- hardening (non-root, no shell) ---
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/ops-terminal/nginx /var/lib/ops-terminal /var/log/ops-terminal
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
