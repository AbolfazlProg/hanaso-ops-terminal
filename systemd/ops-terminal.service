[Unit]
Description=HANASO OPS Web Terminal (ttyd — real root shell behind the auth gateway)
Documentation=https://github.com/AbolfazlProg/hanaso-ops-terminal
After=network-online.target ops-terminal-gateway.service
Wants=network-online.target
Requires=ops-terminal-gateway.service

[Service]
Type=simple
# This service intentionally runs as ROOT: its entire purpose is a real root shell.
# Safety envelope:
#   * ttyd binds to 127.0.0.1 ONLY — no direct external exposure.
#   * Every request (HTTP + WebSocket) is gated upstream by nginx auth_request
#     against the independent auth gateway (system user ops-gw, no system login).
ExecStart=/opt/ops-terminal/bin/ttyd -i 127.0.0.1 -p 7681 -W -O -m 2 -T xterm-256color -t "title=HANASO OPS" -w /root /usr/bin/tmux new -A -s ops
Environment=TMUX_TMPDIR=/var/tmp/ops-terminal
ExecStartPre=/usr/bin/install -d -m 700 -o root -g root /var/tmp/ops-terminal
Restart=always
RestartSec=2
# KillMode=process: on stop/restart only the ttyd main process is signaled; the
# detached tmux server — and the running root session inside it — survives and
# is re-attached automatically on the next start (tmux new -A -s ops).
KillMode=process
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
